# Local development template. Never commit real keys.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_PHONE_NUMBER=
# Public HTTPS origin used for Twilio callbacks, not localhost.
TWILIO_WEBHOOK_BASE_URL=
TWILIO_DEFAULT_WORKSPACE_ID=
PACIFICA_SMS_SENDING_ENABLED=false

OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
PACIFICA_EMAIL_FROM=
PACIFICA_INBOUND_EMAIL_DOMAIN=

STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_AGENCY=

LEAD_WEBHOOK_SECRET=
CRON_SECRET=

# Optional separate encryption key for secure quote-request links (32+ random characters).
# Defaults to a purpose-separated key derived from CLERK_SECRET_KEY; rotating invalidates old links.
QUOTE_INTAKE_SECRET=

# Optional Google Calendar connection. Server-only. See docs/google-calendar.md.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://pacificacrm.com/api/calendar/google/callback
# 32 random bytes encoded as exactly 64 hexadecimal characters.
GOOGLE_CALENDAR_ENCRYPTION_KEY=
