{
  "name": "pacifica-tools",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "sync:clearvoice": "node scripts/sync-clearvoice-assets.mjs",
    "predev": "npm run sync:clearvoice",
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "prebuild": "npm run sync:clearvoice",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --import tsx --test tests/clearvoice.test.mjs tests/communications.test.mjs tests/csv-lead-merge.test.mjs tests/dtmf-tone.test.mjs tests/lead-priority.test.mjs tests/lead-quote-data.test.mjs tests/message-priority.test.mjs tests/mobile-drive-mode.test.mjs tests/post-call.test.mjs tests/production-automation.test.mjs tests/provider-lead-merge.test.mjs tests/revenue-automation.test.mjs tests/twilio-voice-route.test.ts tests/workspace-profile.test.mjs",
    "verify:vercel": "npm run lint && VERCEL=1 npm run build && npm run test:unit",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/clearvoice",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.1",
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "@twilio/voice-sdk": "^2.17.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "openai": "^7.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "standardwebhooks": "^1.0.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Pacifica"
}
