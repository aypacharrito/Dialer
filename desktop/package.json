{
  "name": "pacifica-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.pacificacrm.desktop",
    "productName": "Pacifica",
    "asar": true,
    "files": [
      "main.mjs",
      "preload.cjs",
      "overlay-preload.cjs",
      "package.json",
      "assets/**",
      "overlay.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Pacifica-Setup-${version}.${ext}",
      "icon": "assets/pacifica.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pacifica",
      "installerIcon": "assets/pacifica.ico",
      "uninstallerIcon": "assets/pacifica.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "artifactName": "Pacifica-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "aypacharrito",
        "repo": "Dialer",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
